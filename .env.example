# Supabase local database — Supabase CLI defaults
# host.docker.internal resolves to the host machine on Docker Desktop (Windows/Mac)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable

# Ollama LLM provider — used by message parser for freeform messages
# OLLAMA_BASE_URL: base URL of the Ollama API
#   - Host Ollama reached from the workers container: http://host.docker.internal:11434/v1
#     (use http://localhost:11434/v1 only when running the worker directly on the host)
#   - Ollama Cloud: https://ollama.com/v1
# OLLAMA_API_KEY: leave empty for local (unauthenticated); set to your Ollama Cloud token for cloud
#   Note: this is separate from OPENAI_API_KEY below (which is used by Supabase Studio only)
# OLLAMA_MODEL: any model available in your Ollama instance (default: qwen2.5:3b)
# OLLAMA_ENABLED: set to false to skip the LLM fallback entirely — messages the
#   regex cannot parse then fail fast with a clear parse_error instead of retrying
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ENABLED=true

# Legacy HS256 shared secret — from: supabase status (look for "JWT secret").
# Only used when the HS256 path is active (no JWKS URL, or AUTH_ALLOW_HS256=true).
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# JWKS endpoint for asymmetric (ES256) user access tokens — newer Supabase
# versions sign user JWTs with a rotating asymmetric key instead of the secret.
# Leave empty to accept only HS256 tokens.
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json

# JWT validation knobs
# AUTH_ALLOW_HS256: when a JWKS URL is set, HS256 tokens (e.g. the well-known
#   local anon/service-role keys) are rejected unless this is true. If you
#   enable it, also set AUTH_EXPECTED_AUDIENCE= (empty) — legacy keys carry no aud.
# AUTH_EXPECTED_AUDIENCE: expected aud claim; empty disables the check.
#   Unset in this file ≠ empty: user access tokens carry aud "authenticated".
# AUTH_EXPECTED_ISSUER: expected iss claim; empty disables the check. Local
#   GoTrue mints iss=http://127.0.0.1:54321/auth/v1 regardless of the host
#   alias clients dial, so leave empty for local development.
AUTH_ALLOW_HS256=false
AUTH_EXPECTED_AUDIENCE=authenticated
AUTH_EXPECTED_ISSUER=

# graphql-api runtime tuning (all optional)
# ENV=production disables GraphQL Playground and introspection
# CORS_ALLOWED_ORIGINS: comma-separated, "*" allows any (dev default)
# MAX_BODY_BYTES: request body cap (default 1048576 = 1 MiB)
# RATE_LIMIT_RPS / RATE_LIMIT_BURST: per-IP token bucket (default 50 / 100)
ENV=development
CORS_ALLOWED_ORIGINS=*
MAX_BODY_BYTES=1048576
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Supabase Studio AI (optional — enables AI features in Studio UI)
OPENAI_API_KEY=

# SMS provider — only needed if auth.sms.twilio is enabled in supabase/config.toml
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# OAuth providers — only needed if the corresponding [auth.external.*] is enabled
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# OrioleDB/S3 — only needed if experimental.orioledb_version is set in supabase/config.toml
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
